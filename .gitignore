# ============================================================
# TruthCheck — .gitignore
# ============================================================

# --- Dependencies ---
node_modules/

# --- Environment Variables (NEVER commit real secrets) ---
.env
.env.local
.env.*.local
.env.production
.env.staging

# Allow the example template to be committed
!.env.example

# --- Build Output ---
dist/
build/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Vite Cache ---
.vite/

# --- Optional: MongoDB local data ---
data/
