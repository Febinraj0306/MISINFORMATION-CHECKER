# ============================================================
# TruthCheck — Environment Variables Example
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.
# ============================================================

# Server port (default: 5001)
PORT=5001

# ---------------------------------------------------------------
# Google Gemini API Key (REQUIRED)
# Get yours at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------
# Search API Keys — provide at least ONE for grounding to work.
# Without a search key, the AI will classify from memory only (less accurate).
#
# Tavily (primary, recommended):  https://app.tavily.com
# Serper (fallback):              https://serper.dev
# ---------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# ---------------------------------------------------------------
# MongoDB Connection URI (OPTIONAL)
# If omitted, check history falls back to an in-memory store.
# Local default: mongodb://127.0.0.1:27017/truthcheck
# Atlas example: mongodb+srv://<user>:<pass>@cluster0.mongodb.net/truthcheck
# ---------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/truthcheck
